{
  "name": "cloudflare-ai-firewall",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:firewall": "npm run dev -w apps/firewall-api",
    "dev:manager": "npm run dev -w apps/policy-manager",
    "deploy:firewall": "npm run deploy -w apps/firewall-api",
    "deploy:manager": "npm run deploy -w apps/policy-manager",
    "deploy:tester": "npm run deploy -w apps/firewall-tester",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  }
}
